{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HandwrittenXHSCoverLayout",
  "type": "object",
  "required": ["preset", "title_full", "text_blocks", "constraints", "variants"],
  "properties": {
    "preset": {
      "enum": [
        "vertical_emotion",
        "stamp_travel",
        "subject_outline",
        "scattered_keywords"
      ]
    },
    "image_treatment": {
      "enum": ["none", "desaturate", "film_grain"]
    },
    "title_full": { "type": "string", "maxLength": 30 },
    "text_blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["content", "style", "color", "layout", "position", "size"],
        "properties": {
          "content": { "type": "string" },
          "style": { "const": "bold_childlike_handwriting" },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "layout": { "enum": ["vertical", "horizontal", "scattered"] },
          "position": { "type": "string" },
          "size": { "enum": ["medium", "large", "xlarge"] },
          "outline": { "enum": [null, "white_thick", "white_thin"] }
        }
      }
    },
    "decorations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "enum": ["arrow", "subject_outline", "stamp", "scribble"]
          },
          "text": { "type": "string" },
          "color": { "type": "string" }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "enum": [
          "do_not_cover_face",
          "keep_original_person_unchanged",
          "text_only_in_negative_space"
        ]
      }
    },
    "variants": {
      "type": "object",
      "required": ["A_conservative", "B_emotional"],
      "properties": {
        "A_conservative": {
          "type": "object",
          "properties": {
            "decoration_level": { "enum": ["low", "medium"] },
            "text_scale": { "type": "number", "minimum": 0.7, "maximum": 1.0 }
          }
        },
        "B_emotional": {
          "type": "object",
          "properties": {
            "decoration_level": { "enum": ["medium", "high"] },
            "text_scale": { "type": "number", "minimum": 1.0, "maximum": 1.3 }
          }
        }
      }
    }
  }
}
