{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HandwrittenXHSCoverLayout",
  "type": "object",
  "required": ["preset", "title_full", "cover_ref", "typography_ref", "palette_ref", "text_blocks", "constraints"],
  "properties": {
    "preset": {
      "enum": ["exaggerated_headline", "doodle_fresh", "color_block"]
    },
    "title_full": { "type": "string", "maxLength": 30 },
    "cover_ref": { "type": "string" },
    "typography_ref": {
      "enum": [
        "references/typography-outline.jpg",
        "references/typography-scattered.jpg",
        "references/typography-marker.jpg"
      ]
    },
    "palette_ref": {
      "enum": ["ref-high-energy", "ref-wonder-night", "ref-specialty-dish"]
    },
    "subject_placement": { "type": "string" },
    "subject_scale": { "type": "number", "minimum": 0.25, "maximum": 0.6 },
    "text_blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["content", "color", "position", "size"],
        "properties": {
          "content": { "type": "string" },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "outline_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "outline": {
            "enum": [null, "white_thick", "yellow_thick", "black_thick"]
          },
          "position": { "type": "string" },
          "size": { "enum": ["large", "xlarge"] }
        }
      }
    },
    "block_colors": {
      "type": "array",
      "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
      "maxItems": 3
    },
    "decorations": { "type": "array" },
    "text_scale": { "type": "number", "minimum": 1.0, "maximum": 1.3 },
    "contrast": {
      "type": "object",
      "properties": {
        "target": { "const": "WCAG_AA" },
        "verified": { "type": "boolean" }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "enum": [
          "do_not_cover_face",
          "subject_already_extracted",
          "single_typography_ref_only",
          "reference_palette_only",
          "wcag_aa_contrast"
        ]
      }
    }
  }
}
